<Window x:Class="Lamha.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lamha Settings" Width="520" Height="560" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>
    <!-- Every change is saved right away; there is no Save button. -->
    <TabControl x:Name="Tabs" Margin="8">
        <TabItem Header="Sections" x:Name="SectionsTab">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button x:Name="UpButton" Content="Up" Width="70" Margin="0,0,0,6" />
                    <Button x:Name="DownButton" Content="Down" Width="70" />
                </StackPanel>
                <ListBox x:Name="SectionList" />
            </DockPanel>
        </TabItem>
        <TabItem Header="Location">
            <StackPanel Margin="12">
                <RadioButton x:Name="LocAuto" Content="Use Windows location" GroupName="loc" Margin="0,0,0,6" />
                <RadioButton x:Name="LocCity" Content="Choose a city" GroupName="loc" />
                <ComboBox x:Name="CityBox" Margin="20,4,0,8" Width="220" HorizontalAlignment="Left" />
                <RadioButton x:Name="LocManual" Content="Enter coordinates" GroupName="loc" />
                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                    <TextBlock Text="Lat" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="LatBox" Width="90" />
                    <TextBlock Text="Lon" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBox x:Name="LonBox" Width="90" />
                </StackPanel>
            </StackPanel>
        </TabItem>
        <TabItem Header="Prayer" x:Name="PrayerTab">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="12">
                    <CheckBox x:Name="AlertsBox" Content="Remind me before each prayer" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Minutes before:" VerticalAlignment="Center" />
                        <Slider x:Name="AlertSlider" Minimum="0" Maximum="60" Width="180" Margin="8,0" IsSnapToTickEnabled="True" TickFrequency="1" />
                        <TextBlock Text="{Binding Value, ElementName=AlertSlider}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="Asr calculation" />
                    <ComboBox x:Name="AsrBox" Width="260" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Label}" Text="Adjust time (minutes) and adhan → iqama gap" />
                    <Grid x:Name="PrayerGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" /><ColumnDefinition /><ColumnDefinition Width="40" />
                            <ColumnDefinition /><ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Shortcut">
            <StackPanel Margin="12">
                <TextBlock Text="Click the box, then press the new key combination." TextWrapping="Wrap" />
                <TextBox x:Name="HotkeyBox" Width="220" HorizontalAlignment="Left" Margin="0,8,0,0" IsReadOnly="True" />
                <TextBlock x:Name="HotkeyStatus" Foreground="#FFE24B4A" Margin="0,6,0,0" />
            </StackPanel>
        </TabItem>
        <TabItem Header="Appearance">
            <StackPanel Margin="12">
                <TextBlock Style="{StaticResource Label}" Text="Theme" Margin="0,0,0,4" />
                <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Label}" Text="Panel opacity" />
                <StackPanel Orientation="Horizontal">
                    <Slider x:Name="OpacitySlider" Minimum="60" Maximum="100" Width="220" IsSnapToTickEnabled="True" TickFrequency="5" />
                    <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0}%}" Margin="8,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Label}" Text="Language" />
                <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" />
            </StackPanel>
        </TabItem>
        <TabItem Header="Taskbar" x:Name="TaskbarTab">
            <StackPanel Margin="12">
                <CheckBox x:Name="StripBox" />
                <TextBlock x:Name="StripItemsLabel" Style="{StaticResource Label}" />
                <ComboBox x:Name="StripItem1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6" />
                <ComboBox x:Name="StripItem2" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6" />
                <ComboBox x:Name="StripItem3" Width="220" HorizontalAlignment="Left" />
                <Button x:Name="ResetStripButton" HorizontalAlignment="Left" Padding="10,4" Margin="0,12,0,0" />
                <TextBlock x:Name="StripHint" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </TabItem>
        <TabItem Header="General">
            <StackPanel Margin="12">
                <CheckBox x:Name="StartupBox" Content="Start Lamha with Windows" Margin="0,0,0,8" />
                <CheckBox x:Name="DndBox" Content="Do not disturb while a game, video or presentation is full screen" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
