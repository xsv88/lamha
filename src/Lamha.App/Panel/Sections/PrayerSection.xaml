<UserControl x:Class="Lamha.App.Panel.Sections.PrayerSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" Background="#FF185FA5">
        <StackPanel>
            <DockPanel>
                <TextBlock x:Name="CountdownText" DockPanel.Dock="Right" FontSize="20" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <!-- One column per time: Fajr, Shuruq, Dhuhr, Asr, Maghrib, Isha. -->
            <UniformGrid x:Name="TimesRow" Rows="2" Columns="6" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
</UserControl>
