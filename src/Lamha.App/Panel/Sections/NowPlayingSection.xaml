<UserControl x:Class="Lamha.App.Panel.Sections.NowPlayingSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="Card" CornerRadius="10" Padding="12" Margin="0,0,0,10" Background="#FF3C3489"
            TextElement.Foreground="White">
        <StackPanel>
            <DockPanel>
                <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="#33FFFFFF">
                    <Image x:Name="Cover" Stretch="UniformToFill" />
                </Border>
                <!-- Four bars that bounce while music plays. -->
                <StackPanel x:Name="Equalizer" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Top" Height="14" Margin="8,0,0,0" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubText" FontSize="12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <Grid x:Name="ProgressArea" Margin="0,10,0,0">
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="1"
                             Foreground="White" Background="#40FFFFFF" BorderThickness="0" />
                <TextBlock x:Name="ElapsedText" Grid.Row="1" FontSize="11" Opacity="0.8" HorizontalAlignment="Left" />
                <TextBlock x:Name="TotalText" Grid.Row="1" FontSize="11" Opacity="0.8" HorizontalAlignment="Right" />
            </Grid>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Content="&#xE892;" ToolTip="Previous" />
                <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="Play/Pause" />
                <Button x:Name="NextButton" Style="{StaticResource IconButton}" Content="&#xE893;" ToolTip="Next" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
