<UserControl x:Class="Lamha.App.Panel.Sections.PcLoadSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="0,0,0,4">
        <Grid x:Name="Bars">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
        </Grid>
        <Expander x:Name="More" Header="Show more" Margin="0,6,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel x:Name="TopList" Margin="0,4,0,0" />
        </Expander>
    </StackPanel>
</UserControl>
