<Window x:Class="Lamha.App.Strip.StripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lamha strip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        SizeToContent="WidthAndHeight">
    <!-- Almost-transparent fill so the whole strip catches the mouse, not just the letters. -->
    <Border x:Name="Root" Background="#01000000" Padding="4,2" CornerRadius="4">
        <StackPanel x:Name="Blocks" Orientation="Horizontal" />
    </Border>
</Window>
